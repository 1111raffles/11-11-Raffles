// Raffle Rumble — Prisma Schema
// Development: SQLite  |  Production: switch provider to "postgresql"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  tickets  Ticket[]
  orders   Order[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ── Raffles ───────────────────────────────────────────────────────────────────
// status: DRAFT | ACTIVE | DRAWING | COMPLETED | CANCELLED
model Raffle {
  id              String   @id @default(cuid())
  title           String
  description     String
  imageUrl        String?
  totalTickets    Int      @default(1000)
  soldTickets     Int      @default(0)
  ticketPrice     Float    @default(1.0)
  drawTime        DateTime
  status          String   @default("ACTIVE")
  winnerId        String?
  winnerTicketNum Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tickets       Ticket[]
  announcements Announcement[]

  @@map("raffles")
}

// ── Tickets ───────────────────────────────────────────────────────────────────
model Ticket {
  id           String   @id @default(cuid())
  ticketNumber Int
  userId       String
  raffleId     String
  orderId      String
  isWinner     Boolean  @default(false)
  createdAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  raffle Raffle @relation(fields: [raffleId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([raffleId, ticketNumber])
  @@map("tickets")
}

// ── Orders ────────────────────────────────────────────────────────────────────
// packageType: SINGLE | FIVE_PLUS | TEN_PLUS
// status: PENDING | PAID | FAILED | REFUNDED
model Order {
  id                    String   @id @default(cuid())
  userId                String
  raffleId              String
  packageType           String
  ticketsPurchased      Int
  ticketsBonus          Int      @default(0)
  totalTickets          Int
  amountPaid            Float
  stripePaymentIntentId String?  @unique
  stripeSessionId       String?  @unique
  status                String   @default("PENDING")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  tickets Ticket[]

  @@map("orders")
}

// ── Announcements ─────────────────────────────────────────────────────────────
// type: WINNER | DRAW_STARTING | NEW_RAFFLE | MILESTONE | GENERAL
model Announcement {
  id        String   @id @default(cuid())
  raffleId  String?
  type      String
  message   String
  createdAt DateTime @default(now())

  raffle Raffle? @relation(fields: [raffleId], references: [id])

  @@map("announcements")
}
