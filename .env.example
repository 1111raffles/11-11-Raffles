# ── Database ────────────────────────────────────────────────────────────────
# For local development, SQLite is used. Switch to PostgreSQL for production.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/raffle_rumble"

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Apple / Sign in with Apple ───────────────────────────────────────────────
# Create at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_ID="com.yourapp.services"
APPLE_TEAM_ID="YOUR_TEAM_ID"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_KEY_ID="YOUR_KEY_ID"

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Connect — the platform/owner's connected account ID for direct payouts
# Create at: https://dashboard.stripe.com/connect/accounts/overview
STRIPE_CONNECTED_ACCOUNT_ID="acct_..."

# ── Pusher (real-time) ────────────────────────────────────────────────────────
# Sign up at: https://pusher.com — create a Channels app
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at: https://resend.com — verify your sending domain
RESEND_API_KEY="re_..."
EMAIL_FROM="Raffle Rumble <noreply@rafflerumble.com>"

# ── Admin Authentication ──────────────────────────────────────────────────────
# Change these to strong, unique credentials before deploying!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2b$12$..."  # bcrypt hash — run: node -e "const b=require('bcryptjs'); console.log(b.hashSync('yourpassword',12))"
ADMIN_JWT_SECRET="generate-with: openssl rand -base64 32"

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Raffle Rumble"
